<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <element name="CompleteMultipartUploadResult">
      <element name="Location">
        <data type="anyURI"/>
      </element>
      <element name="Bucket">
        <data type="string"/>
      </element>
      <element name="Key">
        <data type="string"/>
      </element>
      <element name="ETag">
        <data type="string"/>
      </element>
      <optional>
        <group>
          <choice>
            <element name="ChecksumCRC32">
              <data type="string"/>
            </element>
            <element name="ChecksumCRC32C">
              <data type="string"/>
            </element>
            <element name="ChecksumCRC64NVME">
              <data type="string"/>
            </element>
            <element name="ChecksumSHA1">
              <data type="string"/>
            </element>
            <element name="ChecksumSHA256">
              <data type="string"/>
            </element>
          </choice>
          <optional>
            <element name="ChecksumType">
              <data type="string"/>
            </element>
          </optional>
        </group>
      </optional>
    </element>
  </start>
</grammar>
